---
services:
  forgejo:
    image: codeberg.org/forgejo/forgejo:{{ version_tags.forgejo }}-rootless
    container_name: forgejo
    restart: unless-stopped
    user: 1000:1000
    environment:
      USER_UID: 1000
      USER_GID: 1000
      FORGEJO__database__DB_TYPE: postgres
      FORGEJO__database__HOST: forgejo-db:5432
      FORGEJO__database__USER: forgejo
      FORGEJO__database__PASSWD: "{{ forgejo_pg_password }}"
      FORGEJO__database__NAME: forgejo
    volumes:
      - forgejo-data:/var/lib/gitea
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3000:3000"
      - "2222:2222"
    depends_on:
      - db

  db:
    container_name: forgejo-db
    image: postgres:14
    restart: unless-stopped
    environment:
      POSTGRES_USER: forgejo
      POSTGRES_PASSWORD: "{{ forgejo_pg_password }}"
      POSTGRES_DB: forgejo
    volumes:
      - db-data:/var/lib/postgresql/data

volumes:
  forgejo-data:
  db-data:
