services:
  immich-server:
    container_name: immich
    image: ghcr.io/immich-app/immich-server:{{ version_tags.immich }}
    volumes:
      - immich-data:/data
      - /etc/localtime:/etc/localtime:ro
      - {{ photos_directory }}:/mnt/media/photos:ro
    environment:
      TZ: Europe/Madrid
      DB_PASSWORD: {{ immich_pg_password }}
    ports:
      - 2283:2283
    depends_on:
      - redis
      - database
    restart: unless-stopped
    healthcheck:
      disable: false
    devices:
      - /dev/dri:/dev/dri

  immich-machine-learning:
    container_name: immich-machine-learning
    image: ghcr.io/immich-app/immich-machine-learning:{{ version_tags.immich }}
    environment:
      MACHINE_LEARNING_MODEL_REVISION: v2
    volumes:
      - model-cache:/cache
    restart: unless-stopped
    healthcheck:
      disable: false

  redis:
    container_name: immich-redis
    image: docker.io/valkey/valkey:9
    healthcheck:
      test: redis-cli ping | grep -q PONG || exit 1
    restart: unless-stopped

  database:
    container_name: immich-db
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    environment:
      POSTGRES_PASSWORD: {{ immich_pg_password }}
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: --data-checksums
      DB_STORAGE_TYPE: HDD
    volumes:
      - postgres-data:/var/lib/postgresql/data
    shm_size: 128mb
    restart: unless-stopped
    healthcheck:
      disable: false

volumes:
  model-cache:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ immich_mount }}/model-cache
  immich-data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ immich_mount }}/data
  postgres-data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ immich_mount }}/db
