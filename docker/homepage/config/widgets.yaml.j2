---
- datetime:
    text_size: l
    locale: gb
    format:
      timeStyle: medium
      dateStyle: medium
      hourCycle: h23

- resources:
    cpu: true
    memory: true
    cputemp: true
    disk:
      - /
{% if media_directory %}
      - /mnt/mediaserver
{% endif %}

- openmeteo:
    {{ homepage_openmeteo_data | to_nice_yaml | trim | indent(4, false) }}
    units: metric
    cache: 5
    format:
      maximumFractionDigits: 1
