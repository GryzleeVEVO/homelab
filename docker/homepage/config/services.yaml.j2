---
- Media:
{% if "jellyfin" in homepage_services %}
    - Jellyfin:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/jellyfin.svg
        href: {{ homepage_services.jellyfin.url }}
        description: Stream movies and shows
        container: jellyfin
        widget:
            type: jellyfin
            url: {{ homepage_services.jellyfin.url }}
            key: "{{ jellyfin_api_key }}"
            version: 2
            enableBlocks: true
            enableNowPlaying: true
            enableUser: false
            enableMediaControl: false
            showEpisodeNumber: false
            expandOneStreamToTwoRows: false
{% endif %}

{% if "navidrome" in homepage_services %}
    - Navidrome:
        icon: https://cdn.jsdelivr.net/gh/selfhst/icons/svg/navidrome.svg
        href: {{ homepage_services.navidrome.url }}
        description: Stream music
        container: navidrome
        widget:
            type: navidrome
            url: {{ homepage_services.navidrome.url }}
            user: {{ navidrome_username }}
            token: "{{ navidrome_password }}"
            salt: "{{ navidrome_salt }}"
{% endif %}

{% if "paperless" in homepage_services %}
    - Paperless-ngx:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/paperless-ngx.svg
        href: {{ homepage_services.paperless.url }}
        ping: {{ homepage_services.paperless.url }}
        description: Document scanner and manager
        statusStyle: basic
{% endif %}

{% if "immich" in homepage_services %}
    - Immich:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/immich.svg
        href: {{ homepage_services.immich.url }}
        description: Image and video manager
        container: immich
{% endif %}

{% if "nextcloud" in homepage_services %}
    - Nextcloud:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nextcloud.svg
        href: {{ homepage_services.nextcloud.url }}
        description: Cloud storage
        container: nextcloud
{% endif %}

- Monitoring and observability:
{% if "grafana" in homepage_services %}
    - Grafana:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/grafana.svg
        href: {{ homepage_services.grafana.url }}
        description: Visualize metrics, traces and logs
        container: grafana
        widget:
            type: grafana
            version: 2
            alerts: grafana
            url: {{ homepage_services.grafana.url }}
            username: {{ grafana_username }}
            password: "{{ grafana_password }}"
{% endif %}

{% if "prometheus" in homepage_services %}
    - Prometheus:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/prometheus.svg
        href: {{ homepage_services.prometheus.url }}
        description: Time-series database for metrics
        container: prometheus
{% endif %}

{% if "loki" in homepage_services %}
    - Loki:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/loki.svg
        href: {{ homepage_services.loki.url }}
        description: Database for logs
        container: loki
{% endif %}

{% if "alloy" in homepage_services %}
    - Alloy:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/alloy.svg
        href: {{ homepage_services.alloy.url }}
        description: Logs and metrics collector
        ping: {{ homepage_services.alloy.url }}
        statusStyle: basic
{% endif %}

- Library management:
{% if "radarr" in homepage_services %}
    - Radarr:
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/radarr.svg
        href: {{ homepage_services.radarr.url }}
        description: Search and download new movies
        container: radarr
        widget:
            type: radarr
            url: {{ homepage_services.radarr.url }}
            key: "{{ radarr_api_key }}"
            enableQueue: true
{% endif %}

{% if "sonarr" in homepage_services %}
