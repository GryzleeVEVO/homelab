global:
  scrape_interval: 15s

scrape_configs:
{% if "prometheus" in prometheus_targets %}
  - job_name: prometheus
    static_configs:
      - targets:
{% for target in prometheus_targets.prometheus %}
        - {{ target }}
{% endfor %}
{% endif %}

{% if "loki" in prometheus_targets %}
